{
  "id": "demo_batch",
  "display_name": "演示分容（虚构数据）",
  "match": {
    "filename_regex": "^DEMO-BATCH.*\\.txt$",
    "content_signature": [
      "批号",
      "制备日期",
      "演示数据"
    ],
    "scan_lines": 8
  },
  "txt": {
    "header_lines": 3,
    "group_key_column": 0,
    "forward_fill_columns": [],
    "group_fill_columns": [
      0,
      1,
      2,
      3,
      4,
      5
    ],
    "encodings": [
      "utf-8-sig",
      "utf-8",
      "gb18030",
      "gbk"
    ]
  },
  "source": {
    "sample_workbook": "assets/templates/demo_batch.xlsx",
    "sample_sheet": "演示分容",
    "header_rows": 2
  },
  "output": {
    "workbook_name": "演示分容数据.xlsx",
    "sheet_name": "演示分容"
  },
  "columns": [
