{
  "id": "demo_cycle",
  "display_name": "演示循环（虚构数据）",
  "match": {
    "filename_regex": "^DEMO-CYCLE.*\\.txt$",
    "content_signature": [
      "批号",
      "循环开始日期",
      "演示数据"
    ],
    "scan_lines": 8
  },
  "txt": {
    "header_lines": 1,
    "group_key_column": 0,
    "forward_fill_columns": [],
    "group_fill_columns": [
      0,
      1,
      4
    ],
    "encodings": [
      "utf-8-sig",
      "utf-8",
      "gb18030",
      "gbk"
    ]
  },
  "source": {
    "sample_workbook": "assets/templates/demo_cycle.xlsx",
    "sample_sheet": "演示循环",
    "header_rows": 1
  },
  "output": {
    "workbook_name": "演示循环数据.xlsx",
    "sheet_name": "演示循环"
  },
  "columns": [
    {
      "excel": "A",
      "txt": 0,
      "type": "text"
    },
    {
      "excel": "B",
      "txt": 1,
      "type": "text"
    },
    {
      "excel": "C",
      "txt": 2,
      "type": "text"
    },
    {
      "excel": "D",
      "txt": 3,
      "type": "text"
    },
    {
      "excel": "E",
      "txt": 4,
      "type": "text"
    },
    {
      "excel": "F",
      "txt": 5,
      "type": "text"
    },
    {
      "excel": "G",
      "txt": 6,
      "type": "number"
    },
    {
      "excel": "H",
      "txt": 7,
      "type": "number"
    },
    {
      "excel": "I",
      "txt": 8,
      "type": "number"
    }
  ],
  "column_ranges": [
    {
      "excel_from": "L",
      "excel_to": "BF",
      "txt_from": 9,
      "type": "number",
      "formula_columns_every": {
        "start": "N",
        "end": "BF",
        "step": 2
      },
      "formula_source_row": 2
    }
  ],
  "formulas": [],
  "merge": {
    "group_columns": [
      "A",
      "B"
    ],
    "run_columns": [
      "E"
    ]
  },
  "outliers": {},
  "carry_comments": true
}
